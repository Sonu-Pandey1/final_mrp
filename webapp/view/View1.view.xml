<mvc:View
    controllerName="finalmrp.finalmrp.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout.form"
    xmlns="sap.m"
    core:require="{
        customFormatter: 'finalmrp/finalmrp/model/formatter' 
    }">

    <Page id="page" title="{i18n>title}">
<!-- import formatter above so that we can acees here like controller  -->
        <!-- ============ NEW STYLE FORM ============ -->
        <Panel id="simpleFormPanel" class="sapUiResponsiveMargin">
            <headerToolbar>
                <Toolbar id="styleFormToolbar">
                    <Title id="styleFormTitle" text="New Style" />
                    <ToolbarSpacer id="styleFormSpacer" />
                    <Button id="clearStyleFormButton" text="Clear" icon="sap-icon://clear-filter" press="onClearStyleForm" />
                    <Button id="navigateToView2Button" text="Go to Second Screen" press="onNavigateToView2" type="Emphasized" />
                    <Button id="openInfoDialogButton" text="Open Info Dialog" press="onOpenDialog" type="Accept" />
                    
                
                <!-- 1. LIVE SEARCH CONTROLS -->
                <!-- The 'liveChange' or 'search' event fires our controller filtering script -->
                <SearchField 
                    id="searchField" 
                    width="300px" 
                    placeholder="Search by Product Description..." 
                    search="onSearchStyles" />
                
                <!-- 2. SORT TRIGGER BUTTON -->
                <Button 
                    id="sortButton" 
                    icon="sap-icon://sort" 
                    text="Sort by Season" 
                    press="onSortStyles" />
                </Toolbar>
            </headerToolbar>
            <content>
                <VBox id="vbox1" class="sapUiMediumMargin">

                    <Title id="userProfileTitle" text="User Profile" titleStyle="H2" class="sapUiSmallMarginBottom" />
                    <Text id="welcomeText" text="Welcome back, {local>/CurrentUser}!" class="sapUiSmallMarginBottom" />
                    <Text id="appStatusText" text="Application Status: {local>/AppStatus}" class="sapUiMediumMarginBottom" />

                    <Label id="currentUserLabel" text="Change your username here:" />
                    <Input id="currentUserInput" value="{local>/CurrentUser}" width="300px" />

                    <Text id="companyNameText" text="Company Name: {customer>/Company}" />
                    <Text id="logText"
                        text="Log: User {local>/CurrentUser} is working at {customer>/Company} in {customer>/Region}."
                        class="sapUiMediumMarginTop" />

                    <VBox id="styleFormVBox" class="sapUiMediumMarginTop">
                        <layout:SimpleForm id="styleCreationForm" title="Style Creation Form" editable="true">
                            <layout:content>
                                <Label id="newStyleIdLabel" text="New Style ID" />
                                <Input id="newStyleIdInput" value="{draft>/NewStyleID}" placeholder="e.g., ST1003" maxLength="10" />

                                <Label id="seasonClassificationLabel" text="Season Classification" />
                                <Input id="seasonClassificationInput" value="{draft>/NewSeason}" placeholder="e.g., SS27" maxLength="6" />

                                <Label id="styleDescriptionLabel" text="Style Description" />
                                <Input id="styleDescriptionInput" value="{draft>/NewDesc}" placeholder="Enter garment details..." maxLength="40" />
                            </layout:content>
                        </layout:SimpleForm>

                        <Button id="saveDataButton" text="Save Data to Server" press="onSaveDraft" type="Emphasized" class="sapUiSmallMarginTop" />
                    </VBox>
                </VBox>
            </content>
        </Panel>

        <!-- ============ STYLE TABLE ============ -->
        <Panel id="formPanel" headerText="Style Details" class="sapUiResponsiveMargin">
            <headerToolbar>
                <Toolbar id="tableToolbar">
                    <Title id="tableTitle" text="Style Details" />
                    <ToolbarSpacer id="tableSpacer" />
                    <Button id="deleteRecordButton" text="Delete Selected" icon="sap-icon://delete" type="Reject" press="onDeleteRecord" />
                </Toolbar>
            </headerToolbar>
            <content>
                <Table id="stylesTable"
                    mode="SingleSelectMaster"
                    selectionChange="onTableSelectionChange"
                    items="{path: '/ZC_BINDRA_HDR', filters: [{path: 'IsActiveEntity', operator: 'EQ', value1: true}]}">
                    <columns>
                        <Column id="styleIdColumn"><Text id="styleIdHeader" text="Style ID" /></Column>
                        <Column id="seasonColumn"><Text id="seasonHeader" text="Season" /></Column>
                        <Column id="descriptionColumn"><Text id="descriptionHeader" text="Description" /></Column>
                        <Column id="categoryColumn"><Text id="categoryHeader" text="Category" /></Column>
                        <Column id="statusColumn"><Text id="statusHeader" text="Status" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem id="styleRow" type="Navigation" press="onRowPress">
                            <cells>
                                <Text id="styleIdCell" text="{StyleId}" />
                                <Text id="seasonCell" text="{Season}" />
                                <Text id="descriptionCell" text="{ProductDescription}" />
                                <Text id="categoryCell" text="{Category}" />
                                <Text id="statusCell" text="{Status}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <!-- ============ UPDATE BOX ============ -->
                <VBox id="updateBox" visible="false" class="sapUiMediumMarginTop">
                    <Title id="updateTitle" text="Update Selected Style" titleStyle="H3" class="sapUiSmallMarginBottom" />
                    <Label id="updateDescLabel" text="Description" />
                    <Input id="updateDescInput" value="{edit>/Description}" width="300px" maxLength="40" class="sapUiSmallMarginBottom" />
                    <Button id="updateRecordButton" text="Save Changes" type="Emphasized" press="onUpdateRecord" />
                </VBox>
                <VBox id="validationBox" class="sapUiMediumMargin">

                <layout:SimpleForm id="validationForm" title="Product Metadata Validation Form" editable="true">
                    <layout:content>
                        
                        <!-- 1. THE INTEGER TYPE WITH CONSTRAINTS -->
                        <Label id="discountLabel" text="Discount Percentage (0 - 100%)" />
                        <Input id="discountInput" value="{
                            path: 'draft>/Discount',
                            type: 'sap.ui.model.type.Integer',
                            constraints: {
                                minimum: 0,
                                maximum: 100
                            }
                        }" placeholder="Enter integer number..." />

                        <!-- 2. THE DATE TYPE WITH LOCALIZED STYLE -->
                        <Label id="releaseDateLabel" text="Release Target Date" />
                        <Input id="releaseDateInput" value="{path: 'draft>/ReleaseDate',
                            type: 'sap.ui.model.type.Date',
                            formatOptions: {
                                style: 'medium'
                            }
                        }" placeholder="e.g., Oct 7, 2026" />

                        <!-- 3. THE COMPOSITE CURRENCY TYPE -->
                        <Label id="unitPriceLabel" text="Target Unit Price" />
                        <!-- Currency uses the 'parts' array to blend amount and currency code -->
                        <Input id="unitPriceInput" value="{
                            parts: [
                                {path: 'draft>/PriceAmount'},
                                {path: 'draft>/CurrencyCode'}
                            ],
                            type: 'sap.ui.model.type.Currency',
                            formatOptions: {
                                showMeasure: false
                            }
                              }" placeholder="Enter decimal amount..." />
                        
                    </layout:content>
                </layout:SimpleForm>

            </VBox>
            </content>
             
              <content>
            <Table id="stylesTable1" items="{/ZC_BINDRA_HDR}" mode="SingleSelectMaster">
                <columns>
                    <Column id="styleIdColumn2"><Text id="styleIdColumn4" text="Style ID" /></Column>
                    <Column id="statusCodeColumn2"><Text id="statusCodeColumn" text="Status Code (Raw)" /></Column>
                    <Column id="statusDescriptionColumn2"><Text id="statusDescriptionColumn" text="Status Description (Formatted)" /></Column>
                </columns>
                <items>
                    <ColumnListItem id="styleRow2" type="Navigation" press="onRowPress">
                        <cells>
                            <Text id="styleIdCell2" text="{StyleId}" />
                            
                            <!-- Displaying the raw, unformatted value -->
                            <Text id="statusCodeCell2" text="{Status}" />
                            
                            <!-- 2. APPLYING THE FORMATTER FUNCTION -->
                            <!-- We use the format: alias.functionName -->
                            <Text id="statusDescriptionCell2" text="{
                                path: 'Status',
                                formatter: 'customFormatter.statusText'
                            }" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        </Panel>
    </Page>
</mvc:View>